{
  "schemaVersion": 1,
  "scale": 1,
  "size": { "width": 64, "height": 64 },
  "direction": "S",
  "draggable": false,
  "dragInSelectMode": false,
  "rubbable": false,
  "canInspect": true,
  "ai": {
    "defaultAffordances": [
      {
        "actionId": "harvest",
        "purpose": "harvest",
        "chain": true,
        "when": { "method": "isReadyToHarvest" }
      },
      {
        "actionId": "water_plant",
        "purpose": "tend",
        "chain": true,
        "when": {
          "method": "canWater",
          "notMethod": "isReadyToHarvest",
          "contextGate": { "path": "energy", "op": "gt", "value": 0.4 }
        }
      },
      {
        "actionId": "inspect",
        "purpose": "inspect",
        "when": { "method": "canBeInspectedByAi" }
      },
      {
        "actionId": "deep_inspect",
        "purpose": "inspect",
        "when": {
          "method": "canBeInspectedByAi",
          "contextGates": [
            { "path": "curiosity", "op": "gt", "value": 0.78 },
            { "path": "fun", "op": "lt", "value": 0.58 }
          ],
          "novelty": { "op": "gt", "value": 0.55 }
        }
      }
    ]
  },
  "canPickUp": false,
  "particleEffects": false,
  "lightEmission": false,
  "lighting": {
    "emitsLight": false,
    "radius": 160,
    "intensity": 0.8,
    "color": "rgba(255, 214, 150, 1)",
    "falloff": "smooth",
    "castsShadows": false,
    "hero": false,
    "roomFill": 0.3
  },
  "lootable": false,
  "consumable": false,
  "storable": false,
  "saveable": false,
  "respawns": false,
  "respawnTime": 300000,
  "physics": {
    "collision": false,
    "walkable": false,
    "blocksLineOfSight": false
  },
  "interaction": {
    "interactive": true,
    "type": null,
    "radius": 100,
    "cooldown": 5000,
    "side": null,
    "canToggle": false
  },
  "visual": {
    "renderPriority": 1,
    "renderLayer": "objects",
    "overlappable": false,
    "depthOffset": null,
    "depthLine": null,
    "depthPriority": 0,
    "renderType": "single",
    "defaultState": "default",
    "states": ["default"],
    "animates": false,
    "fps": 8
  },
  "soundEffects": {
    "pickup": "ui_pickup_item",
    "drop": "ui_drop_item",
    "drop_error": "ui_error"
  }
}
